<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="repository.aanotherworld" name="AANOTHER Kodi" version="1.0.0" provider-name="AANOTHERWORLD">
    <requires>
      <import addon="xbmc.addon" version="16.1.000"/>
    </requires>
    <extension point="xbmc.addon.repository" name="AANOTHER Kodi">
      <info compressed="false">https://aanotherworld.github.io/KODI_PERSONAL/Repository/addons.xml</info>
      <checksum>https://aanotherworld.github.io/KODI_PERSONAL/Repository/addons.xml.md5</checksum>
      <datadir zip="true">https://aanotherworld.github.io/KODI_PERSONAL/Repository/zips/</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <summary lang="en_US">AANOTHER Kodi personal repository</summary>
      <description lang="en_US">Personal Kodi repository with custom Estuary skin.</description>
    </extension>
  </addon>
  <addon id="skin.estuary" name="AANOTHER Kodi - Estuary Skin" version="4.0.0" provider-name="AANOTHERWORLD">
    <requires>
      <import addon="xbmc.gui" version="5.14.0"/>
    </requires>
    <extension point="xbmc.gui.skin" debugging="false">
      <res width="1920" height="1080" aspect="16:9" default="true" folder="xml"/>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <summary lang="en_US">AANOTHER Kodi custom Estuary skin</summary>
      <description lang="en_US">Customized Estuary skin for the AANOTHER Kodi personal build.</description>
    </extension>
  </addon>
</addons>
