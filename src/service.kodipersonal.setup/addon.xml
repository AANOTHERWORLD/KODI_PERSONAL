<?xml version="1.0" encoding="UTF-8"?>
<!-- Setup service. Applies the personal build defaults on first run and after each
     update, and declares the whole build stack as hard dependencies so Kodi installs
     the entire stack in one pass from the aggregated repository.aanotherworld when
     this addon is installed, and pulls any newly added ones when it updates. The
     floors are 0.0.1 (presence-only): we only need each addon present, not a specific
     version, and the skin and TMDb Helper enforce their own real version needs. Using
     0.0.1 instead of real floors is what avoids "dependency could not be satisfied"
     errors (script.module.jurialmunkey ships as 0.2.35, for example); these imports
     are NOT optional, because optional imports are never auto-installed by Kodi, which
     left Red Light and ResolveURL missing. Every id below resolves through the
     aggregated repo (jurialmunkey, The Red Repo, Gujal00 for ResolveURL, kodiyashimaru
     for the Magneto scraper) or Kodi's official repo (script.trakt, and the
     requests/pil sub-deps of Red Light and Magneto). The
     runtime checker (resources/lib/dependencies.py) re-enables anything disabled and
     notifies if a source was unreachable at install time. -->
<addon id="service.kodipersonal.setup"
       name="KODI Personal Setup"
       version="0.6.7"
       provider-name="AANOTHERWORLD">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="skin.arctic.fuse.3" version="0.0.1" />
    <import addon="plugin.video.themoviedb.helper" version="0.0.1" />
    <import addon="script.skinvariables" version="0.0.1" />
    <import addon="script.module.jurialmunkey" version="0.0.1" />
    <import addon="script.trakt" version="0.0.1" />
    <import addon="plugin.video.redlight" version="0.0.1" />
    <import addon="script.module.resolveurl" version="0.0.1" />
    <import addon="script.module.magneto" version="0.0.1" />
  </requires>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Personal setup service for the lightweight build</summary>
    <description lang="en_GB">Applies the personal build defaults, TMDb Helper behavior and the source player slot, on first run and after each update so every device stays consistent. Copies the ThoughtStream colour set and background, applies the curated AF3 skin settings and view types, and deploys the home menu (Discover, For You, Netflix, Max, and a More Providers submenu) into Arctic Fuse 3 on every start so the look and menu self-heal after a skin update. Declares the build stack as dependencies so Kodi installs them automatically, and verifies them on startup, healing anything missing or disabled. Stores no secrets. Logs to its own profile folder.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
