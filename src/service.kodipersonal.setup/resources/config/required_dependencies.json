{
  "_comment": "Required repos and add-ons for the KODI_PERSONAL build. dependencies.py verifies each is installed AND enabled on startup, logs the result, and notifies if any are missing. 'critical': true means the build cannot function without it. 'install_if_missing': false means a missing entry is only logged and never sent to InstallAddon, which would otherwise raise a Kodi dialog on every start: the upstream repos are optional because repository.aanotherworld already aggregates their sources, and Magneto has no live source since 2026-10-01. Edit this list freely; no code change needed.",
  "repositories": [
    { "id": "repository.aanotherworld", "name": "AANOTHERWORLD Repo",   "critical": true },
    { "id": "repository.jurialmunkey",  "name": "Jurialmunkey Repo",     "critical": false, "install_if_missing": false },
    { "id": "repository.redwizard",     "name": "Red Wizard (Red Repo)", "critical": false, "install_if_missing": false },
    { "id": "repository.openwizard",    "name": "OpenWizard Repo",       "critical": false, "install_if_missing": false }
  ],
  "addons": [
    { "id": "skin.arctic.fuse.3",            "name": "Arctic Fuse 3",        "critical": true },
    { "id": "plugin.video.themoviedb.helper","name": "TMDb Helper",          "critical": true },
    { "id": "script.skinvariables",          "name": "SkinVariables",        "critical": true },
    { "id": "script.module.jurialmunkey",    "name": "Jurialmunkey Module",  "critical": true },
    { "id": "script.trakt",                  "name": "Trakt",                "critical": false },
    { "id": "plugin.video.redlight",         "name": "Red Light (source)",   "critical": false },
    { "id": "script.module.resolveurl",      "name": "ResolveURL",           "critical": false },
    { "id": "script.module.magneto",         "name": "Magneto Module (scrapers)", "critical": false, "install_if_missing": false },
    { "id": "script.module.infotagger",      "name": "InfoTagger (TMDb Helper dep)", "critical": false },
    { "id": "plugin.program.openwizard",     "name": "OpenWizard (backup tool)",  "critical": false },
    { "id": "weather.openmeteo",             "name": "Open-Meteo (weather)",  "critical": false },
    { "id": "service.kodipersonal.setup",    "name": "KodiPersonal Setup",   "critical": true }
  ]
}
