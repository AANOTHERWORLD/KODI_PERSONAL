<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings for the setup service. These back the getSettingBool and -->
<!-- setSetting calls in service.py. last_applied_version is internal state. -->
<settings version="1">
  <section id="service.kodipersonal.setup">
    <category id="general" label="General">
      <group id="1">
        <setting id="apply_on_update" type="boolean" label="Re-apply defaults after each update">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting id="show_notifications" type="boolean" label="Show a notification when defaults are applied">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting id="last_applied_version" type="string">
          <level>0</level>
          <default></default>
          <control type="label" />
          <visible>false</visible>
        </setting>
        <setting id="texturecache_cleared" type="string">
          <level>0</level>
          <default></default>
          <control type="label" />
          <visible>false</visible>
        </setting>
        <setting id="texturecache_pruned" type="string">
          <level>0</level>
          <default></default>
          <control type="label" />
          <visible>false</visible>
        </setting>
      </group>
    </category>
  </section>
</settings>
