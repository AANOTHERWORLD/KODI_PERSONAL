<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings for the setup service. These back the getSettingBool and -->
<!-- setSetting calls in service.py. last_applied_version is internal state. -->
<settings version="1">
  <section id="service.kodipersonal.setup">
    <category id="general" label="General">
      <group id="1">
        <setting id="apply_on_update" type="boolean" label="Re-apply defaults after each update">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting id="show_notifications" type="boolean" label="Show a notification when defaults are applied">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting id="last_applied_version" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
        <setting id="texturecache_cleared" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
        <setting id="texturecache_pruned" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
        <setting id="magneto_initialised" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
        <setting id="packagecache_purged" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
        <setting id="weather_configured" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
        <setting id="traktsync_repaired" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
        <setting id="af3_menu_version" type="string">
          <level>0</level>
          <default></default>
          <control type="edit" format="string" />
          <visible>false</visible>
        </setting>
      </group>
    </category>
    <category id="autoplay" label="Autoplay">
      <group id="1">
        <setting id="autoplay_enabled" type="boolean" label="When a show is caught up, play the next show in Up Next">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
        <setting id="autoplay_countdown" type="integer" label="Countdown before playing (seconds)">
          <level>0</level>
          <default>10</default>
          <constraints>
            <minimum>3</minimum>
            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer" />
        </setting>
        <setting id="autoplay_chain_limit" type="integer" label="Ask &quot;Still watching?&quot; after this many automatic plays">
          <level>0</level>
          <default>3</default>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>20</maximum>
          </constraints>
          <control type="slider" format="integer" />
        </setting>
        <setting id="autoplay_wrap" type="boolean" label="Go back to the top of Up Next when the row runs out">
          <level>0</level>
          <default>false</default>
          <control type="toggle" />
        </setting>
      </group>
    </category>
  </section>
</settings>
