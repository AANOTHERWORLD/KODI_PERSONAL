<?xml version="1.0" encoding="UTF-8"?>
<addons><addon id="repository.aanotherworld" name="KODI_PERSONAL Repository" version="1.0.0" provider-name="AANOTHERWORLD">
    <extension point="xbmc.addon.repository" name="KODI_PERSONAL">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/AANOTHERWORLD/KODI_PERSONAL/main/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/AANOTHERWORLD/KODI_PERSONAL/main/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/AANOTHERWORLD/KODI_PERSONAL/main/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Personal Kodi repository</summary>
        <description lang="en">Hosts the personal lightweight build addons so every device updates from one source.</description>
        <platform>all</platform>
    </extension>
</addon><addon id="resource.font.thoughtstream" name="ThoughtStream Fonts" version="0.1.0" provider-name="AANOTHERWORLD">
  <requires>
    <import addon="kodi.resource" version="1.0.0" />
  </requires>
  <extension point="kodi.resource.fonts" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">ThoughtStream font set, Libre Baskerville and Inter</summary>
    <description lang="en_GB">Open licensed fonts for the ThoughtStream layer. Libre Baskerville 700 for titles, Inter 400 and 600 for UI. Referenced over resource:// in the same way Arctic Fuse 3 references its own font resource addon.</description>
    <platform>all</platform>
    <license>SIL Open Font License 1.1</license>
  </extension>
</addon><addon id="service.kodipersonal.setup" name="KODI Personal Setup" version="0.1.0" provider-name="AANOTHERWORLD">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Personal setup service for the ThoughtStream layer</summary>
    <description lang="en_GB">Applies the ThoughtStream accent and writes the home menu and widget rows that ride on top of Arctic Fuse 3. Does not modify the skin. Logs to its own profile folder.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon></addons>