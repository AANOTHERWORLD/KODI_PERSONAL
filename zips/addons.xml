  </requires>
  <extension point="kodi.resource.fonts" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">ThoughtStream font set, Libre Baskerville and Inter</summary>
    <description lang="en_GB">Open licensed fonts for the ThoughtStream layer. Libre Baskerville 700 for titles, Inter 400 and 600 for UI. Referenced over resource:// in the same way Arctic Fuse 3 references its own font resource addon.</description>
