    <license>SIL Open Font License 1.1</license>
  </extension>
</addon><addon id="service.kodipersonal.setup" name="KODI Personal Setup" version="0.6.2" provider-name="AANOTHERWORLD">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="skin.arctic.fuse.3" version="0.0.1" optional="true" />
    <import addon="plugin.video.themoviedb.helper" version="0.0.1" optional="true" />
    <import addon="script.skinvariables" version="0.0.1" optional="true" />
    <import addon="script.module.jurialmunkey" version="0.0.1" optional="true" />
    <import addon="script.trakt" version="0.0.1" optional="true" />
    <import addon="plugin.video.redlight" version="0.0.1" optional="true" />
    <import addon="script.module.resolveurl" version="0.0.1" optional="true" />
  </requires>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Personal setup service for the lightweight build</summary>
    <description lang="en_GB">Applies the personal build defaults, TMDb Helper behavior and the source player slot, on first run and after each update so every device stays consistent. Copies the ThoughtStream colour set and background, applies the curated AF3 skin settings and view types, and deploys the home menu (Discover, For You, Netflix, Max, and a More Providers submenu) into Arctic Fuse 3 on every start so the look and menu self-heal after a skin update. Declares the build stack as dependencies so Kodi installs them automatically, and verifies them on startup, healing anything missing or disabled. Stores no secrets. Logs to its own profile folder.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon></addons>