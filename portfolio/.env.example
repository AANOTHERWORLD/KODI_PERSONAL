# Copy to .env.local for local work. Production builds should leave both unset.

# Show projects, assets, and claims that are still awaiting permission or verification.
# Draft content renders with a visible "Draft" marker. Default: off.
NEXT_PUBLIC_SHOW_DRAFTS=false

# Host the site under a subpath, for example GitHub Pages without a custom domain.
# Example: NEXT_PUBLIC_BASE_PATH=/portfolio
NEXT_PUBLIC_BASE_PATH=

# Turn on the guarded debug logger in the browser and during the build.
NEXT_PUBLIC_DEBUG=false
